import React, { useState, useEffect } from 'react';
import { Plus, Trash2, Edit2, Calendar, Users, AlertCircle, CheckCircle, Clock, FileSpreadsheet, Loader2, Link as LinkIcon, LayoutDashboard, CalendarDays, FileText, ExternalLink, FileAudio } from 'lucide-react';

export default function App() {
  const [activeTab, setActiveTab] = useState('Tasks'); // 'Tasks', 'Meetings', 'Documents'
  const [appData, setAppData] = useState({
    Tasks: [],
    Meetings: [],
    Documents: []
  });
  
  const [loading, setLoading] = useState(false);
  const [syncing, setSyncing] = useState(false);
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [editingItem, setEditingItem] = useState(null);
  
  const DEFAULT_URL = 'https://script.google.com/macros/s/AKfycbx1mfEp5N2Xe-Bfj4zM4YZ0zvPy_nhzHa8K8aGe049LiNFvSX3-jSBiZFIFn5H4luI-vw/exec';
  const [scriptUrl, setScriptUrl] = useState(() => localStorage.getItem('gas_script_url') || DEFAULT_URL);
  const [showUrlInput, setShowUrlInput] = useState(false);

  // Form states based on activeTab
  const [taskForm, setTaskForm] = useState({ title: '', phase: 'Giai đoạn 1', deadline: '', assignee: '', status: 'todo' });
  const [meetingForm, setMeetingForm] = useState({ time: '', content: '', attendees: '', docLink: '' });
  const [docForm, setDocForm] = useState({ name: '', link: '' });

  // --- GOOGLE APPS SCRIPT API CALLS ---
  const callGAS = async (action, payload = {}) => {
    if (!scriptUrl) return null;
    setSyncing(true);
    try {
      const response = await fetch(scriptUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ action, ...payload })
      });
      const result = await response.json();
      if (!result.success) throw new Error(result.error);
      return result;
    } catch (error) {
      console.error("Lỗi đồng bộ:", error);
      alert("Lỗi đồng bộ dữ liệu: " + error.message);
      return null;
    } finally {
      setSyncing(false);
    }
  };

  const fetchAllData = async () => {
    if (!scriptUrl) return;
    setLoading(true);
    try {
      const [tasksRes, meetingsRes, docsRes] = await Promise.all([
        callGAS('GET_DATA', { sheetName: 'Tasks' }),
        callGAS('GET_DATA', { sheetName: 'Meetings' }),
        callGAS('GET_DATA', { sheetName: 'Documents' })
      ]);
      
      setAppData({
        Tasks: tasksRes?.data || [],
        Meetings: meetingsRes?.data || [],
        Documents: docsRes?.data || []
      });
    } catch (error) {
       console.error("Lỗi tải dữ liệu ban đầu", error);
    }
    setLoading(false);
  };

  useEffect(() => {
    if (scriptUrl && !showUrlInput) {
      fetchAllData();
    }
  }, [scriptUrl, showUrlInput]);

  const handleSaveUrl = () => {
    if (scriptUrl) {
      localStorage.setItem('gas_script_url', scriptUrl);
      setShowUrlInput(false);
    }
  };

  // --- KANBAN DRAG & DROP ---
  const handleDragStart = (e, taskId) => {
    e.dataTransfer.setData('taskId', taskId);
  };

  const handleDrop = async (e, newStatus) => {
    e.preventDefault();
    const taskId = e.dataTransfer.getData('taskId');
    if (!taskId) return;

    setAppData(prev => ({
      ...prev,
      Tasks: prev.Tasks.map(t => t.id === taskId ? { ...t, status: newStatus } : t)
    }));
    
    const taskToUpdate = appData.Tasks.find(t => t.id === taskId);
    if (taskToUpdate) {
       await callGAS('UPDATE_DATA', { sheetName: 'Tasks', item: { ...taskToUpdate, status: newStatus } });
    }
  };

  // --- CRUD OPERATIONS ---
  const handleSaveItem = async (e) => {
    e.preventDefault();
    
    const currentForm = activeTab === 'Tasks' ? taskForm : activeTab === 'Meetings' ? meetingForm : docForm;
    const sheetName = activeTab;

    if (editingItem) {
      const updatedItem = { ...editingItem, ...currentForm };
      
      // Update UI optimistically
      setAppData(prev => ({
        ...prev,
        [sheetName]: prev[sheetName].map(item => item.id === updatedItem.id ? updatedItem : item)
      }));
      // Sync
      await callGAS('UPDATE_DATA', { sheetName, item: updatedItem });
    } else {
      const tempId = 'temp-' + Date.now();
      const newItem = { ...currentForm, id: tempId };
      
      setAppData(prev => ({
        ...prev,
        [sheetName]: [...prev[sheetName], newItem]
      }));
      
      const result = await callGAS('ADD_DATA', { sheetName, item: currentForm });
      if (result && result.data) {
         setAppData(prev => ({
           ...prev,
           [sheetName]: prev[sheetName].map(item => item.id === tempId ? result.data : item)
         }));
      }
    }
    closeModal();
  };

  const handleDeleteItem = async (itemId) => {
    if (window.confirm('Bạn có chắc chắn muốn xóa mục này khỏi Google Sheets?')) {
      const sheetName = activeTab;
      setAppData(prev => ({
        ...prev,
        [sheetName]: prev[sheetName].filter(item => item.id !== itemId)
      }));
      await callGAS('DELETE_DATA', { sheetName, itemId });
    }
  };

  // --- MODAL CONTROLS ---
  const openModal = (item = null) => {
    setEditingItem(item);
    if (activeTab === 'Tasks') {
      setTaskForm(item ? { title: item.title, phase: item.phase, deadline: item.deadline, assignee: item.assignee, status: item.status } 
                       : { title: '', phase: 'Giai đoạn 1', deadline: '', assignee: '', status: 'todo' });
    } else if (activeTab === 'Meetings') {
      setMeetingForm(item ? { time: item.time, content: item.content, attendees: item.attendees, docLink: item.docLink }
                          : { time: '', content: '', attendees: '', docLink: '' });
    } else if (activeTab === 'Documents') {
      setDocForm(item ? { name: item.name, link: item.link }
                      : { name: '', link: '' });
    }
    setIsModalOpen(true);
  };

  const closeModal = () => {
    setIsModalOpen(false);
    setEditingItem(null);
  };

  // --- RENDER HELPERS ---
  const renderTasksBoard = () => {
    const columns = [
      { id: 'todo', title: 'Cần làm', icon: <AlertCircle className="w-5 h-5 text-gray-500" />, color: 'bg-gray-100' },
      { id: 'in_progress', title: 'Đang thực hiện', icon: <Clock className="w-5 h-5 text-blue-500" />, color: 'bg-blue-50' },
      { id: 'done', title: 'Hoàn thành', icon: <CheckCircle className="w-5 h-5 text-green-500" />, color: 'bg-green-50' }
    ];

    return (
      <div className="flex flex-col lg:flex-row gap-6 items-start animate-fade-in">
        {columns.map(col => (
          <div 
            key={col.id} 
            className={`flex-1 w-full rounded-xl p-4 min-h-[500px] border border-gray-200 ${col.color}`}
            onDragOver={(e) => e.preventDefault()}
            onDrop={(e) => handleDrop(e, col.id)}
          >
            <div className="flex items-center justify-between mb-4 pb-2 border-b border-gray-300">
              <div className="flex items-center gap-2">
                {col.icon}
                <h2 className="font-semibold text-lg text-gray-800">{col.title}</h2>
              </div>
              <span className="bg-white text-gray-600 text-xs font-bold px-2.5 py-1 rounded-full shadow-sm">
                {appData.Tasks.filter(t => t.status === col.id).length}
              </span>
            </div>
            <div className="space-y-3">
              {appData.Tasks.filter(t => t.status === col.id).map(task => (
                <div 
                  key={task.id} draggable onDragStart={(e) => handleDragStart(e, task.id)}
                  className="bg-white p-4 rounded-lg shadow-sm border border-gray-200 cursor-grab hover:shadow-md transition-shadow group"
                >
                  <div className="flex justify-between items-start mb-2">
                    <span className="text-xs font-semibold px-2 py-1 rounded-md bg-purple-100 text-purple-700">{task.phase}</span>
                    <div className="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                      <button onClick={() => openModal(task)} className="p-1 text-gray-400 hover:text-blue-600"><Edit2 className="w-4 h-4" /></button>
                      <button onClick={() => handleDeleteItem(task.id)} className="p-1 text-gray-400 hover:text-red-600"><Trash2 className="w-4 h-4" /></button>
                    </div>
                  </div>
                  <h3 className="font-medium text-gray-800 mb-3">{task.title}</h3>
                  <div className="flex flex-col gap-2 text-sm text-gray-500">
                    <div className="flex items-center gap-2"><Users className="w-4 h-4" /><span className="truncate">{task.assignee || 'Chưa phân công'}</span></div>
                    <div className="flex items-center gap-2"><Calendar className="w-4 h-4" /><span>{task.deadline ? new Date(task.deadline).toLocaleDateString('vi-VN') : 'Không có hạn'}</span></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    );
  };

  const renderMeetings = () => (
    <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden animate-fade-in">
      <div className="overflow-x-auto">
        <table className="w-full text-left text-sm text-gray-600">
          <thead className="bg-gray-50 text-gray-700 uppercase font-semibold border-b border-gray-200">
            <tr>
              <th className="px-6 py-4">Thời gian</th>
              <th className="px-6 py-4">Nội dung họp</th>
              <th className="px-6 py-4">Thành phần tham dự</th>
              <th className="px-6 py-4 text-center">Tài liệu đính kèm</th>
              <th className="px-6 py-4 text-right">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            {appData.Meetings.length === 0 ? (
              <tr><td colSpan="5" className="text-center py-8 text-gray-400">Chưa có lịch họp nào. Nhấn "Thêm lịch họp" để tạo.</td></tr>
            ) : appData.Meetings.map((meeting) => (
              <tr key={meeting.id} className="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                <td className="px-6 py-4 font-medium text-blue-700 whitespace-nowrap">
                  {meeting.time ? new Date(meeting.time).toLocaleString('vi-VN', {hour: '2-digit', minute:'2-digit', day:'2-digit', month:'2-digit', year:'numeric'}) : ''}
                </td>
                <td className="px-6 py-4 font-medium text-gray-800">{meeting.content}</td>
                <td className="px-6 py-4"><div className="flex items-center gap-2"><Users className="w-4 h-4 text-gray-400"/> {meeting.attendees}</div></td>
                <td className="px-6 py-4 text-center">
                  {meeting.docLink ? (
                    <a href={meeting.docLink} target="_blank" rel="noreferrer" className="inline-flex items-center gap-1 px-3 py-1 bg-indigo-50 text-indigo-600 rounded-full text-xs font-semibold hover:bg-indigo-100 transition-colors">
                      <LinkIcon className="w-3 h-3"/> Xem tài liệu
                    </a>
                  ) : <span className="text-gray-400 text-xs">-</span>}
                </td>
                <td className="px-6 py-4 text-right">
                  <div className="flex justify-end gap-2">
                    <button onClick={() => openModal(meeting)} className="p-2 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded"><Edit2 className="w-4 h-4" /></button>
                    <button onClick={() => handleDeleteItem(meeting.id)} className="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded"><Trash2 className="w-4 h-4" /></button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );

  const renderDocuments = () => (
    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 animate-fade-in">
      {appData.Documents.length === 0 ? (
        <div className="col-span-full text-center py-12 bg-white rounded-xl border border-gray-200 text-gray-400">
          Chưa có tài liệu nào. Nhấn "Thêm tài liệu" để lưu trữ link.
        </div>
      ) : appData.Documents.map((doc) => (
        <div key={doc.id} className="bg-white p-5 rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-all group flex flex-col h-full">
          <div className="flex justify-between items-start mb-4">
            <div className="p-3 bg-blue-50 rounded-lg text-blue-600"><FileText className="w-6 h-6" /></div>
            <div className="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
              <button onClick={() => openModal(doc)} className="p-1.5 text-gray-400 hover:text-blue-600 rounded"><Edit2 className="w-4 h-4" /></button>
              <button onClick={() => handleDeleteItem(doc.id)} className="p-1.5 text-gray-400 hover:text-red-600 rounded"><Trash2 className="w-4 h-4" /></button>
            </div>
          </div>
          <h3 className="font-semibold text-gray-800 text-lg mb-2 flex-1">{doc.name}</h3>
          <a href={doc.link} target="_blank" rel="noreferrer" className="mt-4 flex items-center justify-center gap-2 w-full py-2 bg-gray-50 hover:bg-gray-100 text-gray-700 rounded-lg text-sm font-medium transition-colors border border-gray-200">
            <ExternalLink className="w-4 h-4" /> Mở Tài liệu
          </a>
        </div>
      ))}
    </div>
  );

  // --- INIT SCREEN ---
  if (showUrlInput) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gray-50 p-4">
        <div className="bg-white p-8 rounded-xl shadow-lg max-w-md w-full border-t-4 border-blue-600">
          <h2 className="text-2xl font-bold text-gray-800 mb-4 flex items-center gap-2"><FileSpreadsheet className="text-blue-600" /> Kết nối Google Sheets</h2>
          <p className="text-gray-600 mb-6 text-sm">Vui lòng nhập <strong className="text-gray-800">Web App URL</strong> của Google Apps Script (Phiên bản Đa nhiệm) để đồng bộ Công việc, Lịch họp và Tài liệu.</p>
          <input 
            type="text" value={scriptUrl} onChange={(e) => setScriptUrl(e.target.value)}
            placeholder="https://script.google.com/macros/s/.../exec"
            className="w-full border border-gray-300 rounded-lg px-4 py-3 mb-4 focus:ring-2 focus:ring-blue-500 outline-none text-sm"
          />
          <button 
            onClick={handleSaveUrl} disabled={!scriptUrl}
            className="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg disabled:opacity-50 transition-colors"
          >
            Kết nối & Tải dữ liệu
          </button>
        </div>
      </div>
    );
  }

  if (loading && !appData.Tasks.length && !appData.Meetings.length && !appData.Documents.length) {
    return (
      <div className="min-h-screen flex flex-col items-center justify-center bg-gray-50">
        <Loader2 className="w-10 h-10 animate-spin text-blue-600 mb-4" />
        <p className="text-gray-600 font-medium">Đang tải cấu trúc dữ liệu...</p>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-100 font-sans p-4 md:p-8">
      <div className="max-w-7xl mx-auto">
        {/* Header */}
        <div className="bg-white rounded-xl shadow-sm p-6 mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4 border border-gray-200 border-l-4 border-l-blue-600">
          <div>
            <div className="flex items-center gap-3">
              <h1 className="text-2xl md:text-3xl font-bold text-gray-800">Quản lý Sự kiện 2026</h1>
              {syncing && <span className="flex items-center text-xs font-medium bg-blue-100 text-blue-700 px-2 py-1 rounded-full"><Loader2 className="w-3 h-3 animate-spin mr-1" /> Đang lưu...</span>}
            </div>
            <p className="text-gray-500 mt-1">Hội nghị Quốc tế & Ngày ĐMST Vùng Đông Nam Bộ</p>
          </div>
          
          <div className="flex gap-3">
            <button onClick={() => setShowUrlInput(true)} className="flex items-center gap-2 bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-medium transition-colors" title="Đổi CSDL">
              <LinkIcon className="w-4 h-4" /> Đổi CSDL
            </button>
            <button onClick={() => openModal()} className="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium shadow-sm transition-colors">
              <Plus className="w-4 h-4" /> Thêm {activeTab === 'Tasks' ? 'công việc' : activeTab === 'Meetings' ? 'lịch họp' : 'tài liệu'}
            </button>
          </div>
        </div>

        {/* Navigation Tabs */}
        <div className="flex space-x-2 mb-6 overflow-x-auto pb-2">
          <button onClick={() => setActiveTab('Tasks')} className={`flex items-center gap-2 px-5 py-3 rounded-lg font-semibold transition-all whitespace-nowrap ${activeTab === 'Tasks' ? 'bg-blue-600 text-white shadow-md' : 'bg-white text-gray-600 hover:bg-gray-50 border border-gray-200'}`}>
            <LayoutDashboard className="w-5 h-5" /> Kanban Công việc
          </button>
          <button onClick={() => setActiveTab('Meetings')} className={`flex items-center gap-2 px-5 py-3 rounded-lg font-semibold transition-all whitespace-nowrap ${activeTab === 'Meetings' ? 'bg-blue-600 text-white shadow-md' : 'bg-white text-gray-600 hover:bg-gray-50 border border-gray-200'}`}>
            <CalendarDays className="w-5 h-5" /> Lịch Họp ({appData.Meetings.length})
          </button>
          <button onClick={() => setActiveTab('Documents')} className={`flex items-center gap-2 px-5 py-3 rounded-lg font-semibold transition-all whitespace-nowrap ${activeTab === 'Documents' ? 'bg-blue-600 text-white shadow-md' : 'bg-white text-gray-600 hover:bg-gray-50 border border-gray-200'}`}>
            <FileAudio className="w-5 h-5" /> Kho Tài liệu ({appData.Documents.length})
          </button>
        </div>

        {/* Dynamic Content */}
        {activeTab === 'Tasks' && renderTasksBoard()}
        {activeTab === 'Meetings' && renderMeetings()}
        {activeTab === 'Documents' && renderDocuments()}
      </div>

      {/* Dynamic Modal */}
      {isModalOpen && (
        <div className="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 z-50 animate-fade-in">
          <div className="bg-white rounded-xl shadow-xl w-full max-w-md p-6">
            <h2 className="text-xl font-bold text-gray-800 mb-4">
              {editingItem ? 'Cập nhật' : 'Thêm mới'} {activeTab === 'Tasks' ? 'Công việc' : activeTab === 'Meetings' ? 'Lịch họp' : 'Tài liệu'}
            </h2>
            
            <form onSubmit={handleSaveItem} className="space-y-4">
              {/* TASKS FORM */}
              {activeTab === 'Tasks' && (
                <>
                  <div><label className="block text-sm font-medium text-gray-700 mb-1">Tên công việc</label><input type="text" required value={taskForm.title} onChange={e => setTaskForm({...taskForm, title: e.target.value})} className="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 outline-none" /></div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">Giai đoạn</label>
                    <select value={taskForm.phase} onChange={e => setTaskForm({...taskForm, phase: e.target.value})} className="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 outline-none">
                      <option value="Giai đoạn 1">Giai đoạn 1 (01/3 – 15/4)</option><option value="Giai đoạn 2">Giai đoạn 2 (15/4 – 30/6)</option><option value="Giai đoạn 3">Giai đoạn 3 (30/6 – 31/8)</option><option value="Hoàn thiện chương trình">Hoàn thiện chương trình (01/9 – 15/9)</option><option value="Giai đoạn 4">Giai đoạn 4 (15/9 – 30/9)</option><option value="Giai đoạn 5">Giai đoạn 5 (01/10 - 15/10)</option><option value="Ngày sự kiện">Ngày sự kiện (16/10)</option><option value="Hậu sự kiện">Hậu sự kiện (17/10 - 30/11)</option>
                    </select>
                  </div>
                  <div><label className="block text-sm font-medium text-gray-700 mb-1">Người/Ban phụ trách</label><input type="text" value={taskForm.assignee} onChange={e => setTaskForm({...taskForm, assignee: e.target.value})} className="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 outline-none"/></div>
                  <div className="grid grid-cols-2 gap-4">
                    <div><label className="block text-sm font-medium text-gray-700 mb-1">Thời hạn</label><input type="date" value={taskForm.deadline} onChange={e => setTaskForm({...taskForm, deadline: e.target.value})} className="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 outline-none"/></div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700 mb-1">Trạng thái</label>
                      <select value={taskForm.status} onChange={e => setTaskForm({...taskForm, status: e.target.value})} className="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 outline-none">
                        <option value="todo">Cần làm</option><option value="in_progress">Đang thực hiện</option><option value="done">Hoàn thành</option>
                      </select>
                    </div>
                  </div>
                </>
              )}

              {/* MEETINGS FORM */}
              {activeTab === 'Meetings' && (
                <>
                  <div><label className="block text-sm font-medium text-gray-700 mb-1">Thời gian</label><input type="datetime-local" required value={meetingForm.time} onChange={e => setMeetingForm({...meetingForm, time: e.target.value})} className="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 outline-none" /></div>
                  <div><label className="block text-sm font-medium text-gray-700 mb-1">Nội dung họp</label><textarea required rows="2" value={meetingForm.content} onChange={e => setMeetingForm({...meetingForm, content: e.target.value})} className="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Bàn về..."></textarea></div>
                  <div><label className="block text-sm font-medium text-gray-700 mb-1">Thành phần tham dự</label><input type="text" required value={meetingForm.attendees} onChange={e => setMeetingForm({...meetingForm, attendees: e.target.value})} className="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Vd: Ban nội dung, ĐH FPT..."/></div>
                  <div><label className="block text-sm font-medium text-gray-700 mb-1">Link tài liệu đính kèm (Tuỳ chọn)</label><input type="url" value={meetingForm.docLink} onChange={e => setMeetingForm({...meetingForm, docLink: e.target.value})} className="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 outline-none" placeholder="https://docs.google.com/..."/></div>
                </>
              )}

              {/* DOCUMENTS FORM */}
              {activeTab === 'Documents' && (
                <>
                  <div><label className="block text-sm font-medium text-gray-700 mb-1">Tên tài liệu</label><input type="text" required value={docForm.name} onChange={e => setDocForm({...docForm, name: e.target.value})} className="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Vd: Kế hoạch phân công chi tiết" /></div>
                  <div><label className="block text-sm font-medium text-gray-700 mb-1">Link truy cập (Google Drive, Dropbox...)</label><input type="url" required value={docForm.link} onChange={e => setDocForm({...docForm, link: e.target.value})} className="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 outline-none" placeholder="https://..."/></div>
                </>
              )}

              <div className="flex justify-end gap-3 mt-6">
                <button type="button" onClick={closeModal} className="px-4 py-2 text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg font-medium transition-colors">Hủy bỏ</button>
                <button type="submit" className="px-4 py-2 text-white bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition-colors">Lưu trữ</button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
